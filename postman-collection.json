{
  "info": {
    "name": "LMS Backend API",
    "description": "Learning Management System API with JWT Authentication, Role-based Access, and Course Management",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register as Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Johnson\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"student\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Register a new student user"
          },
          "response": []
        },
        {
          "name": "Register as Instructor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Teacher\",\n  \"email\": \"bob@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"instructor\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Register a new instructor user"
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Login user and get JWT token"
          },
          "response": []
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "profile"]
            },
            "description": "Get authenticated user profile"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "Create Course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Learn Node.js and Express.js\",\n  \"description\": \"Complete course on building scalable backend applications with Node.js, Express.js, and MongoDB. Includes authentication, database design, and deployment.\",\n  \"category\": \"web-development\",\n  \"duration\": 40,\n  \"level\": \"beginner\",\n  \"price\": 99\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/courses",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "courses"]
            },
            "description": "Create a new course (Instructor only)"
          },
          "response": []
        },
        {
          "name": "Get All Courses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/courses?page=1&limit=10&sort=-createdAt",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "courses"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "sort",
                  "value": "-createdAt"
                }
              ]
            },
            "description": "Get all courses with pagination and sorting"
          },
          "response": []
        },
        {
          "name": "Get Courses by Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/courses/category/web-development?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "courses", "category", "web-development"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Get courses filtered by category"
          },
          "response": []
        },
        {
          "name": "Get Course by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/courses/{{course_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "courses", "{{course_id}}"]
            },
            "description": "Get a specific course by ID"
          },
          "response": []
        },
        {
          "name": "Update Course",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Learn Node.js and Express.js - Updated\",\n  \"description\": \"Updated description for the course\",\n  \"price\": 129,\n  \"level\": \"intermediate\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/courses/{{course_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "courses", "{{course_id}}"]
            },
            "description": "Update a course (Instructor only)"
          },
          "response": []
        },
        {
          "name": "Delete Course",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/courses/{{course_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "courses", "{{course_id}}"]
            },
            "description": "Delete a course (Instructor only)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Enrollments",
      "item": [
        {
          "name": "Enroll in Course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": \"{{course_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/enrollments/enroll",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "enrollments", "enroll"]
            },
            "description": "Enroll a student in a course"
          },
          "response": []
        },
        {
          "name": "Get My Enrollments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/enrollments/my-enrollments?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "enrollments", "my-enrollments"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Get all enrollments of logged-in student"
          },
          "response": []
        },
        {
          "name": "Update Progress",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"progress\": 50\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/enrollments/{{enrollment_id}}/progress",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "enrollments", "{{enrollment_id}}", "progress"]
            },
            "description": "Update course progress (0-100)"
          },
          "response": []
        },
        {
          "name": "Drop Course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/enrollments/{{course_id}}/drop",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "enrollments", "{{course_id}}", "drop"]
            },
            "description": "Drop a course"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        },
        "description": "Check if server is running"
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "course_id",
      "value": ""
    },
    {
      "key": "enrollment_id",
      "value": ""
    }
  ]
}
